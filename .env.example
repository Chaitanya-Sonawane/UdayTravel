# Client Firebase & App Check Config (Prefix NEXT_PUBLIC_ for client-side bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Server Firebase Admin & App Check Enforcement
# Base64-encoded Firebase Service Account JSON (cat serviceAccountKey.json | base64 -w 0)
FIREBASE_SERVICE_ACCOUNT_B64=
# Set "true" in production to enforce App Check; "false" in emulator/development
APP_CHECK_ENFORCE=false

# Admin Portal Passphrase / Secret Key
ADMIN_SECRET_KEY=uday_admin_secret_2026

# Optional Emulator Hosts (uncomment when running against Firebase Emulator Suite)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
