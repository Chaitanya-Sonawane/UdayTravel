# ==============================================================================
# UDAY TRAVELS — ENVIRONMENT CONFIGURATION TEMPLATE
# For local development (.env.local) and Vercel Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY CONFIGURATION (Default: TEST MODE)
# ------------------------------------------------------------------------------
# Set mode to 'test' for development and initial Vercel deploy.
# When ready for production live transactions, change RAZORPAY_MODE to 'live'
# and replace key IDs with rzp_live_ credentials. The system strictly checks key prefix!
RAZORPAY_MODE=test
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Browser SDK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=udaytravels-ad458.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=udaytravels-ad458
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=udaytravels-ad458.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://udaytravels-ad458-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# Recommended for Vercel: set individual credentials or Base64 encoded JSON
FIREBASE_PROJECT_ID=udaytravels-ad458
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@udaytravels-ad458.iam.gserviceaccount.com
# Handle newlines: replace \n with literal newlines or paste with \n escaped
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternatively, paste Base64 encoded Service Account JSON:
# cat serviceAccountKey.json | base64 -w 0
# FIREBASE_SERVICE_ACCOUNT_B64=

# ------------------------------------------------------------------------------
# 4. APP SECURITY & PORTAL KEYS
# ------------------------------------------------------------------------------
APP_CHECK_ENFORCE=false
ADMIN_SECRET_KEY=uday_admin_secret_2026

# ------------------------------------------------------------------------------
# 5. OPTIONAL LOCAL EMULATORS
# ------------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
