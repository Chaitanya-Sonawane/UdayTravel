rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. DEFAULT DENY ALL by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Wallets & Wallet Transactions:
    // STRICT RULE: Clients can only READ their own wallet and ledger.
    // ZERO client writes allowed. All mutations occur exclusively in server route handlers via firebase-admin.
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Top-level walletTransactions ledger
    match /walletTransactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // 3. Bookings & Tickets:
    // Clients can only READ their own bookings/tickets.
    // ZERO client writes allowed. Ticket creation and confirmation happen strictly via server-side payment verification.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.contactMobile == request.auth.token.phone_number);
      allow write: if false;
    }

    match /tickets/{ticketNo} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.contactMobile == request.auth.token.phone_number);
      allow write: if false;
    }

    // 4. Payments & Orders:
    // Clients can never write payment receipts or orders. Server route handlers only.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // 5. Seat Status & Availability:
    // Public read for viewing seat status, but ZERO client writes (holds and locks managed via server API).
    match /seat_public/{tripId} {
      allow read: if true;
      allow write: if false;
    }

    match /availability/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /trips/{tripId} {
      allow read: if true;
      allow write: if false;
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. User Profiles & Saved Passengers:
    // Users can read and update their own contact details and saved passengers.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'claims', 'isAdmin']));
      allow delete: if false;

      match /passengers/{passengerId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
